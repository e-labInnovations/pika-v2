DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/pika-v2
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3333
NEXT_PUBLIC_PAYLOAD_AUTH_URL=http://localhost:3333

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: https://your-domain/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the MiniLM embedding weights (~22MB) are cached. Defaults to
# <cwd>/.cache/transformers-models; production points it at shared/ so the
# weights survive a deploy. See docs/DEPLOYMENT.md.
# TRANSFORMERS_CACHE_DIR=/www/wwwroot/pika.elabins.com/app/shared/model-cache
